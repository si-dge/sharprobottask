{
  "require": {
    "php": ">=8.4.1",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-curl": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "phpoffice/phpspreadsheet": "^2.2",
    "doctrine/orm": "^3.3",
    "illuminate/database": "^12.0",
    "illuminate/events": "^12.0",
    "doctrine/migrations": "^3.9",
    "symfony/cache": "^7.0",
    "symfony/var-exporter": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^5.5",
    "tuupola/slim-jwt-auth": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.75",
    "doctrine/data-fixtures": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Fixtures\\": "database/fixtures/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "cs-check": "php-cs-fixer check --config=.php-cs-fixer.php",
    "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "db:seed": "php bin/doctrine-fixtures.php",
    "serve": "php -S 0.0.0.0:8080 -t public"
  }
}

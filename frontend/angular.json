{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "catalog": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/catalog",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "../docs",
                "output": "docs"
              },
              {
                "glob": "swagger-ui.css",
                "input": "node_modules/swagger-ui-dist",
                "output": "swagger-ui"
              },
              {
                "glob": "swagger-ui-bundle.js",
                "input": "node_modules/swagger-ui-dist",
                "output": "swagger-ui"
              },
              {
                "glob": "swagger-ui-standalone-preset.js",
                "input": "node_modules/swagger-ui-dist",
                "output": "swagger-ui"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.css"
            ]
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "catalog:build:production"
            },
            "development": {
              "buildTarget": "catalog:build"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "eff759de-ee0d-4194-b682-059572b4209a"
  }
}
